@startuml
title Диаграмма классов: Список дел (с наследованием хранилищ)

class Task {
  +title: str
  +deadline: str
  +done: bool
  +mark_done()
  +__str__(): str
}

class TaskManager {
  -tasks: list[Task]
  +add_task(title: str, deadline: str): Task
  +remove_task(title: str)
  +mark_done(title: str)
  +get_all(): list[Task]
  +get_pending(): list[Task]
  +count(): int
  +find_by_title(fragment: str): list[Task]
}

abstract class Storage {
  +load(): list[Task]
  +save(tasks: list[Task])
}

class FileStorage {
  -filename: str
  +load(): list[Task]
  +save(tasks: list[Task])
}

class MemoryStorage {
  -data: list[Task]
  +load(): list[Task]
  +save(tasks: list[Task])
}

class ConsoleUI {
  -manager: TaskManager
  +run()
  +print_menu()
  +add_flow()
  +mark_flow()
  +remove_flow()
  +show_all()
  +show_pending()
  +search_flow()
}

ConsoleUI --> TaskManager
TaskManager "1" o-- "0..*" Task
TaskManager ..> Storage
Storage <|-- FileStorage
Storage <|-- MemoryStorage
@enduml
